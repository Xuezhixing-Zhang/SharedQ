#!/bin/bash
#PBS -N rw_cal_gate
#PBS -l nodes=1
#PBS -l walltime=72:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -q long

set -euo pipefail

module load cmake/3.21.4 r/4.4.0
export R_LIBS_USER="$HOME/R/x86_64-pc-linux-gnu-library/4.4"

cd /data/cheungyb/home/e1404425/SharedQ

: "${CALIBRATION_SETTING:?Set CALIBRATION_SETTING to Setting1, Setting2, Setting3, or SupplSetting3_NoShared.}"
: "${CALIBRATION_GATE_PROFILE:?Set CALIBRATION_GATE_PROFILE to a unique candidate profile name.}"

case "$CALIBRATION_SETTING" in
  Setting1)
    setting_dir="Simulation_random_walk/Setting1"
    script_path="$setting_dir/spec_calibration.R"
    ;;
  Setting2)
    setting_dir="Simulation_random_walk/Setting2"
    script_path="$setting_dir/spec_calibration.R"
    ;;
  Setting3)
    setting_dir="Simulation_random_walk/Setting3"
    script_path="$setting_dir/spec_calibration.R"
    ;;
  SupplSetting3_NoShared)
    setting_dir="Simulation_random_walk/SupplSetting3_NoShared"
    script_path="$setting_dir/spec_calibration.R"
    ;;
  *)
    echo "Unknown CALIBRATION_SETTING: $CALIBRATION_SETTING" >&2
    exit 2
    ;;
esac

export CALIBRATION_SPEC_MODE="${CALIBRATION_SPEC_MODE:-default}"
export CALIBRATION_MC_N="${CALIBRATION_MC_N:-1000000}"
export CALIBRATION_MAXEVAL="${CALIBRATION_MAXEVAL:-150000}"
export CALIBRATION_LOCAL_MAXEVAL="${CALIBRATION_LOCAL_MAXEVAL:-30000}"
export CALIBRATION_N_STARTS="${CALIBRATION_N_STARTS:-5}"
export CALIBRATION_PRINT_LEVEL="${CALIBRATION_PRINT_LEVEL:-0}"
export CALIBRATION_OUTPUT_DIR="${CALIBRATION_OUTPUT_DIR:-$setting_dir/calibration/gate_candidates/$CALIBRATION_GATE_PROFILE}"

mkdir -p "$CALIBRATION_OUTPUT_DIR"

echo "Calibration setting: $CALIBRATION_SETTING"
echo "Gate profile: $CALIBRATION_GATE_PROFILE"
echo "Selected specs mode: $CALIBRATION_SPEC_MODE"
echo "Output dir: $CALIBRATION_OUTPUT_DIR"

Rscript "$script_path"
